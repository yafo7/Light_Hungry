ckgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7037, "version": 1, "versionNonce": 3859, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "07", "originalText": "07", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "weight-0228", "type": "text", "x": 1363.4285714285716, "y": 899, "width": 126.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7068, "version": 1, "versionNonce": 3876, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "右岸调镜喂鳞", "originalText": "右岸调镜喂鳞", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "weight-0229", "type": "text", "x": 1363.4285714285716, "y": 935, "width": 144.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7099, "version": 1, "versionNonce": 3893, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "泵房入口根缝松开", "originalText": "泵房入口根缝松开", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "weight-0230", "type": "text", "x": 52, "y": 1007, "width": 779.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7130, "version": 1, "versionNonce": 3910, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "本版新增提案：实体有重量，光态不触发重量压板。种荚压板＋叶槽收起，才构成稳定通路。", "originalText": "本版新增提案：实体有重量，光态不触发重量压板。种荚压板＋叶槽收起，才构成稳定通路。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "weight-0231", "type": "text", "x": 52, "y": 1043, "width": 705.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7161, "version": 1, "versionNonce": 3927, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "originalText": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "weight-0232", "type": "text", "x": 52, "y": 1071, "width": 603.0, "height": 21.6, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7192, "version": 1, "versionNonce": 3944, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "v02 设计提案 · 图示最终解法 · 跳距、压板阈值、叶槽运动与安全恢复仍需灰盒验证。", "originalText": "v02 设计提案 · 图示最终解法 · 跳距、压板阈值、叶槽运动与安全恢复仍需灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 16}, {"id": "weight-0233", "type": "rectangle", "x": 0, "y": 1180, "width": 1600, "height": 1100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7223, "version": 1, "versionNonce": 3961, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "weight-0234", "type": "text", "x": 55, "y": 1215, "width": 642.0, "height": 48.6, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7254, "version": 1, "versionNonce": 3978, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 36, "fontFamily": 2, "text": "04  机关状态｜让重量留下，让光线通过", "originalText": "04  机关状态｜让重量留下，让光线通过", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 36}, {"id": "weight-0235", "type": "text", "x": 57, "y": 1265, "width": 945.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7285, "version": 1, "versionNonce": 3995, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "观察两条因果：压板控制远处叶帘；导向叶槽放下时会阻挡主光。没有倒计时，也不要求先失败一次。", "originalText": "观察两条因果：压板控制远处叶帘；导向叶槽放下时会阻挡主光。没有倒计时，也不要求先失败一次。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "weight-0236", "