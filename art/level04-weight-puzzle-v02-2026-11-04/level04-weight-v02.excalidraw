d": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "points": [[13.634486245123298, 6.253062036438109], [0.0, 12.506124072876219], [0.0, 0.0], [13.634486245123298, 6.253062036438109]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "weight-0365", "type": "rectangle", "x": 838, "y": 2030, "width": 280.0, "height": 30.650000000000002, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11315, "version": 1, "versionNonce": 6205, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "weight-0366", "type": "text", "x": 845, "y": 2033, "width": 266.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11346, "version": 1, "versionNonce": 6222, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "精灵可在旁边化光，独自过水。", "originalText": "精灵可在旁边化光，独自过水。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "weight-0367", "type": "text", "x": 845, "y": 2071, "width": 200.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11377, "version": 1, "versionNonce": 6239, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "叶槽：收起    叶帘：抬起", "originalText": "叶槽：收起    叶帘：抬起", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "weight-0368", "type": "text", "x": 62, "y": 2156, "width": 552.0, "height": 32.400000000000006, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11408, "version": 1, "versionNonce": 6256, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 24, "fontFamily": 2, "text": "解法：用种荚持续压住机关，再收起叶槽清空光路。", "originalText": "解法：用种荚持续压住机关，再收起叶槽清空光路。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "weight-0369", "type": "text", "x": 62, "y": 2202, "width": 714.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11439, "version": 1, "versionNonce": 6273, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "可通过走离压板提前观察失重反馈；化光试验不强制跌水，不设置机关限时。", "originalText": "可通过走离压板提前观察失重反馈；化光试验不强制跌水，不设置机关限时。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "weight-0370", "type": "text", "x": 62, "y": 2244, "width": 594.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 11470, "version": 1, "versionNonce": 6290, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "“光态无重量”是本版新增设计提案；安全恢复与光路阻断细节尚需验证。", "originalText": "“光态无重量”是本版新增设计提案；安全恢复与光路阻断细节尚需验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}], "appState": {"viewBackgroundColor": "#F7F5EF", "gridSize": null}, "files": {}}