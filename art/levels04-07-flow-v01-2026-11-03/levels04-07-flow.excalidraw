ize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "flow-00157", "type": "text", "x": 1276.8, "y": 935, "width": 108.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4867, "version": 1, "versionNonce": 2669, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "步行进入泵房", "originalText": "步行进入泵房", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "flow-00158", "type": "text", "x": 52, "y": 1007, "width": 646.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4898, "version": 1, "versionNonce": 2686, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "落脚点：两岸与中岛。光路分两次接通，途中没有“强光自动吸走”的规则。", "originalText": "落脚点：两岸与中岛。光路分两次接通，途中没有“强光自动吸走”的规则。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "flow-00159", "type": "text", "x": 52, "y": 1043, "width": 705.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4929, "version": 1, "versionNonce": 2703, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "originalText": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "flow-00160", "type": "text", "x": 52, "y": 1071, "width": 715.0, "height": 21.6, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4960, "version": 1, "versionNonce": 2720, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "originalText": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 16}, {"id": "flow-00161", "type": "rectangle", "x": 1680, "y": 0, "width": 1600, "height": 1100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4991, "version": 1, "versionNonce": 2737, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false}, {"id": "flow-00162", "type": "text", "x": 1735, "y": 35, "width": 606.0, "height": 48.6, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 5022, "version": 1, "versionNonce": 2754, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 36, "fontFamily": 2, "text": "05  废弃泵房｜沿光爬升，穿过玻璃架", "originalText": "05  废弃泵房｜沿光爬升，穿过玻璃架", "textAlign": "left", "verticalAlign": "top", "containerId