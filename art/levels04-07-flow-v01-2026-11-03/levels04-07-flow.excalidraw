keColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 23994, "version": 1, "versionNonce": 13158, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "originalText": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 16}], "appState": {"viewBackgroundColor": "#F7F5EF", "gridSize": null}, "files": {}}