 2956.8, "y": 935, "width": 144.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10416, "version": 1, "versionNonce": 5712, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "经检修孔进入温室", "originalText": "经检修孔进入温室", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "flow-00337", "type": "text", "x": 1732, "y": 1007, "width": 585.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10447, "version": 1, "versionNonce": 5729, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "与第 06 关区分：本关重点是竖向攀升和透光踏板；不增加升镜机关。", "originalText": "与第 06 关区分：本关重点是竖向攀升和透光踏板；不增加升镜机关。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "flow-00338", "type": "text", "x": 1732, "y": 1043, "width": 705.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10478, "version": 1, "versionNonce": 5746, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "originalText": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "flow-00339", "type": "text", "x": 1732, "y": 1071, "width": 715.0, "height": 21.6, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10509, "version": 1, "versionNonce": 5763, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "originalText": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 16}, {"id": "flow-00340", "type": "rectangle", "x": 0, "y": 1180, "width": 1600, "height": 1100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10540, "version": 1, "versionNonce": 5780, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false}, {"id": "flow-00341", "type": "text", "x": 55, "y": 1215, "width": 570.0, "height": 48.6, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10571, "version": 1, "versionNonce": 5797, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 36, "fontFamily": 2, "text": "06  温室苗床｜三次过沟，逐次配光", "originalText": "06  温室苗床｜三次过沟，逐次配光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 36}, {"id": "flow