": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0318", "type": "rectangle", "x": 765, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9858, "version": 1, "versionNonce": 5406, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "pump-v2-0319", "type": "text", "x": 787, "y": 1260, "width": 169.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9889, "version": 1, "versionNonce": 5423, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "B  狭缝舱卷轮", "originalText": "B  狭缝舱卷轮", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "pump-v2-0320", "type": "text", "x": 787, "y": 1307, "width": 336.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9920, "version": 1, "versionNonce": 5440, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "抵达限制：完整外壳只留一条细缝。", "originalText": "抵达限制：完整外壳只留一条细缝。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0321", "type": "text", "x": 787, "y": 1345, "width": 341.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9951, "version": 1, "versionNonce": 5457, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "机关作用：展开实体前往 C 的跳台。", "originalText": "机关作用：展开实体前往 C 的跳台。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0322", "type": "rectangle", "x": 1470, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9982, "version": 1, "versionNonce": 5474, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "pump-v2-0323", "type": "text", "x": 1492, "y": 1260, "width": 172.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10013, "version": 1, "versionNonce": 5491, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "D  夹层内手轮", "originalText": "D  夹层内手轮", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "pump-v2-0324", "type": "text", "x": 1492, "y": 1307, "width": 336.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10044, "version": 1, "versionNonce": 5508, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "抵达限制：仅入射光可穿玻璃底板。", "originalText": "抵达限制：仅入射光可穿玻璃底板。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0325", "type": "text", "x": 1492, "y": 1345, "width": 357.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10075, "version": 1, "versionNonce": 5525, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "机关作用：远调末镜，照亮侧腹光鳞。", "originalText": "机关作用：远调末镜，照亮侧腹光鳞。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0326", "type": "text", "x": 62, "y": 1431, "width": 1126.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10106, "version": 1, "versionNonce": 5542, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "规则不变：站在有效光中 3 秒化光；手动沿光路前后移动。所有机关须恢复实体后操作；K1 / K2 开启后保持。", "originalText": "规则不变：站在有效光中 3 秒化光；手动沿光路前后移动。所有机关须恢复实体后操作；K1 / K2 开启后保持。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "pump-v2-0327", "type": "text", "x": 62, "y": 1480, "width": 946.0, "height": 29.700000000000003, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10137, "version": 1, "versionNonce": 5559, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "原版的玻璃规则保留：实体能站，光与光核能穿。S1 保证往返，S2 负责末段；两束光互不切断。", "originalText": "原版的玻璃规则保留：实体能站，光与光核能穿。S1 保证往返，S2 负责末段；两束光互不切断。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "pump-v2-0328", "type": "text", "x": 62, "y": 1521, "width": 946.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 10168, "version": 1, "versionNonce": 5576, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "v02 空间与依赖草图 · 箭头略偏离光束便于阅读 · 非比例碰撞图，实际跳距、缝隙净空和光学角度仍需灰盒验证。", "originalText": "v02 空间与依赖草图 · 箭头略偏离光束便于阅读 · 非比例碰撞图，实际跳距、缝隙净空和光学角度仍需灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}], "appState": {"viewBackgroundColor": "#F7F5EF", "gridSize": null}, "files": {}}