ext": "06  侧腹光鳞受光", "originalText": "06  侧腹光鳞受光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "pump-v2-0312", "type": "text", "x": 1700, "y": 1057, "width": 300.0, "height": 54.0, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9672, "version": 1, "versionNonce": 5304, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "持续对准目标，根帘舒展。\n实体短跳 → 检修孔 → 第 06 关。", "originalText": "持续对准目标，根帘舒展。\n实体短跳 → 检修孔 → 第 06 关。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "pump-v2-0313", "type": "text", "x": 1700, "y": 1160, "width": 294.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9703, "version": 1, "versionNonce": 5321, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "光态负责抵达；实体负责操作。", "originalText": "光态负责抵达；实体负责操作。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "pump-v2-0314", "type": "rectangle", "x": 60, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9734, "version": 1, "versionNonce": 5338, "isDeleted": false, "boundElements": null, "updated": 1793750400000, 