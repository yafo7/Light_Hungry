, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 46500, "version": 1, "versionNonce": 25500, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "胸侧光鳞受光", "originalText": "胸侧光鳞受光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "later-flow-01501", "type": "text", "x": 1327.3333333333333, "y": 5655, "width": 162.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 46531, "version": 1, "versionNonce": 25517, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "同标高进入中央心庭", "originalText": "同标高进入中央心庭", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "later-flow-01502", "type": "text", "x": 52, "y": 5727, "width": 739.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 46562, "version": 1, "versionNonce": 25534, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "γ 穿过前后台之间的开放空井，不穿楼板。前层隔间与后层上下廊均不能直接步行贯通。", "originalText": "γ 穿过前后台之间的开放空井，不穿楼板。前层隔间与后层上下廊均不能直接步行贯通。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "later-flow-01503", "type": "text", "x": 52, "y": 5763, "width": 705.0, "height": 24.3, "angl