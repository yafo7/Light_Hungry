0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20181, "version": 1, "versionNonce": 11067, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "肩颈受光", "originalText": "肩颈受光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "later-flow-00652", "type": "text", "x": 1327.3333333333333, "y": 3295, "width": 126.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20212, "version": 1, "versionNonce": 11084, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "沿光到塔楼破窗", "originalText": "沿光到塔楼破窗", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "later-flow-00653", "type": "text", "x": 52, "y": 3367, "width": 798.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20243, "version": 1, "versionNonce": 11101, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "露珠光路是关卡折射示意；叶台固定，调节的是露珠支架。两段光路之间必须经过实体跳跃段。", "originalText": "露珠光路是关卡折射示意；叶台固定，调节的是露珠支架。两段光路之间必须经过实体跳跃段。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "later-flow-00654", "type": "text", "x": 52, "y": 3403, "width": 705.0, "height": 24.3, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20274, "version": 1, "versionNonce": 11118, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 18, "fontFamily": 2, "text": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "originalText": "共同规则：站光 3 秒化光；沿光路手动前后移动。圆号表示先后顺序，箭头不限制回退。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 18}, {"id": "later-flow-00655", "type": "text", "x": 52, "y": 3431, "width": 715.0, "height": 21.6, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20305, "version": 1, "versionNonce": 11135, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "originalText": "v01 非比例草图 · 展示完成态光路，按步骤接通 · 恢复点为设计建议；跳距、碰撞和切换待灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 16}, {"id": "later-flow-00656", "type": "rectangle", "x": 1680, "y": 2360, "width": 1600, "height": 1100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20336, "version": 1, "versionNonce": 11152, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false}, {"id": "later-flow-00657", "type": "text", "x": 1735, "y": 2395, "width": 606.0, "height": 48.6, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20367, "version": 1, "versionNonce": 11169, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 36, "fontFamily": 2, "text": "11  观测暗室｜斜向跨层，对准错位孔", "originalText": "11  观测暗室｜斜向跨层，对准错位孔", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 36}, {"id": "later-flow-00658", "type": "text", "x": 1737, "y": 2445, "width": 966.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20398, "version": 1, "versionNonce": 11186, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "场景：同一座观测塔内部　　身体局部：颈侧　　核心：镜面角度改变另一层落点；用侧面观察理解纵深", "originalText": "场景：同一座观测塔内部　　身体局部：颈侧　　核心：镜面角度改变另一层落点；用侧面观察理解纵深", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "later-flow-00659", "type": "rectangle", "x": 1728, "y": 2490, "width": 1504, "height": 54, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20429, "version": 1, "versionNonce": 11203, "isDeleted": false, "boundElements": null, "updated": 1793664000000, "link": null, "locked": false}, {"id": "later-flow-00660", "type": "line", "x": 1750, "y": 2517, "width": 55, "height": 0.01,