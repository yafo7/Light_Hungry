0, "link": null, "locked": false}, {"id": "greenhouse-00260", "type": "text", "x": 93, "y": 1320, "width": 156.0, "height": 56.7, "angle": 0, "strokeColor": "#287FAF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8060, "version": 1, "versionNonce": 4420, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "按 E → 恢复重力\n短距离落在 P 上", "originalText": "按 E → 恢复重力\n短距离落在 P 上", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "greenhouse-00261", "type": "rectangle", "x": 845, "y": 1337, "width": 123.0, "height": 94.10000000000001, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8091, "version": 1, "versionNonce": 4437, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00262", "type": "text", "x": 852, "y": 1340, "width": 109.0, "height": 89.10000000000001, "angle": 0, "strokeColor": "#D56D2F", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8122, "version": 1, "versionNonce": 4454, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "站回光里\n充能 3 秒\n再向右回 B", "originalText": "站回光里\n充能 3 秒\n再向右回 B", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00263", "type": "rectangle", "x": 423, "y": 1493, "width": 312.0, "height": 32.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8153, "version": 1, "versionNonce": 4471, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00264", "type": "text", "x": 430, "y": 1496, "width": 298.0, "height": 27.0, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8184, "version": 1, "versionNonce": 4488, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "P 镜片低于来光，不会截走返程光", "originalText": "P 镜片低于来光，不会截走返程光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "greenhouse-00265", "type": "rectangle", "x": 77, "y": 1538, "width": 474.0, "height": 33.35, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8215, "version": 1, "versionNonce": 4505, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00266", "type": "text", "x": 84, "y": 1541, "width": 460.0, "height": 28.35, "angle": 0, "strokeColor": "#8664B2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8246, "version": 1, "versionNonce": 4522, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "K 固定在沟壁；没有低位托盘，就无法站稳操作。", "originalText": "K 固定在沟壁；没有低位托盘，就无法站稳操作。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "greenhouse-00267", "type": "rectangle", "x": 1140, "y": 1162, "width": 1200, "height": 418, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8277, "version": 1, "versionNonce": 4539, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00268", "type": "text", "x": 1168, "y": 1180, "width": 319.0, "height": 39.150000000000006, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8308, "version": 1, "versionNonce": 4556, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 29, "fontFamily": 2, "text": "真正需要推理的三个问题", "originalText": "真正需要推理的三个问题", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 29}, {"id": "greenhouse-00269", "type": "text", "x": 1170, "y": 1241, "width": 175.0, "height": 33.75, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8339, "version": 1, "versionNonce": 4573, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "落脚还是接光？", "originalText": "落脚还是接光？", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-00270", "type": "text", "x": 1170, "y": 1281, "width": 509.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8370, "version": 1, "versionNonce": 4590, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "P 低位才能碰到 K；P 高位才能把 C 的光交给 D。", "originalText": "P 低位才能碰到 K；P 高位才能把 C 的光交给 D。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-00271", "type": "text", "x": 1170, "y": 1344, "width": 225.0, "height": 33.75, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8401, "version": 1, "versionNonce": 4607, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "什么时候收走旧光？", "originalText": "什么时候收走旧光？", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-00272", "type": "text", "x": 1170, "y": 1384, "width": 529.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8432, "version": 1, "versionNonce": 4624, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "必须先开帘、升起托盘并回到 A，再放弃下层路线。", "originalText": "必须先开帘、升起托盘并回到 A，再放弃下层路线。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-00273", "type": "text", "x": 1170, "y": 1447, "width": 327.0, "height": 33.75, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8463, "version": 1, "versionNonce": 4641, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "闸开了，为什么仍到不了 D？", "originalText": "闸开了，为什么仍到不了 D？", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-00274", "type": "text", "x": 1170, "y": 1487, "width": 527.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8494, "version": 1, "versionNonce": 4658, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "如果忘记升 P，光穿孔后会落空；可原路回去修正。", "originalText": "如果忘记升 P，光穿孔后会落空；可原路回去修正。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-00275", "type": "text", "x": 62, "y": 1612, "width": 1071.0, "height": 33.75, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8525, "version": 1, "versionNonce": 4675, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "途中按 E：脚下短距内有安全平台才恢复并下落；无落点则保持光态。机关仍需实体站稳后操作。", "originalText": "途中按 E：脚下短距内有安全平台才恢复并下落；无落点则保持光态。机关仍需实体站稳后操作。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-00276", "type": "text", "x": 62, "y": 1657, "width": 1126.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8556, "version": 1, "versionNonce": 4692, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "安全规则：G 开启后锁止；错误镜向可反调；P 高位也是可站的实体平台；落水返回固定岸台，已开机关保留。", "originalText": "安全规则：G 开启后锁止；错误镜向可反调；P 高位也是可站的实体平台；落水返回固定岸台，已开机关保留。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-00277", "type": "text", "x": 62, "y": 1700, "width": 989.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8587, "version": 1, "versionNonce": 4709, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "v02 设计提案，尚未实装。主图非比例；窄缝净空、最大跳距、三秒充能区与脱光下落需 Unity 灰盒验证。", "originalText": "v02 设计提案，尚未实装。主图非比例；窄缝净空、最大跳距、三秒充能区与脱光下落需 Unity 灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "greenhouse-00278", "type": "rectangle", "x": 0, "y": 1840, "width": 2400, "height": 1740, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8618, "version": 1, "versionNonce": 4726, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00279", "type": "text", "x": 60, "y": 1878, "width": 876.0, "height": 56.7, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8649, "version": 1, "versionNonce": 4743, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 42, "fontFamily": 2, "text": "06  六个连续状态｜同一空间，只保留当前光路", "originalText": "06  六个连续状态｜同一空间，只保留当前光路", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 42}, {"id": "greenhouse-00280", "type": "text", "x": 62, "y": 1942, "width": 909.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8680, "version": 1, "versionNonce": 4760, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "读图重点：② 与 ③ 在同一束下层光内完成；④ 托盘已经升回，玩家仍要回 A 才能换光。", "originalText": "读图重点：② 与 ③ 在同一束下层光内完成；④ 托盘已经升回，玩家仍要回 A 才能换光。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-00281", "type": "rectangle", "x": 60, "y": 1995, "width": 1120, "height": 482, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8711, "version": 1, "versionNonce": 4777, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00282", "type": "text", "x": 78, "y": 2009, "width": 305.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8742, "version": 1, "versionNonce": 4794, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "① A → B：先准备落脚点", "originalText": "① A → B：先准备落脚点", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-00283", "type": "rectangle", "x": 76.0, "y": 2054.0, "width": 1064.0, "height": 332.63300000000004, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 0.665, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8773, "version": 1, "versionNonce": 4811, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00284", "type": "rectangle", "x": 89.3, "y": 2061.3017, "width": 1037.4, "height": 314.37874999999997, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#EEF1E9", "fillStyle": "solid", "strokeWidth": 1.33, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8804, "version": 1, "versionNonce": 4828, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00285", "type": "line", "x": 102.6, "y": 2068.19775, "width": 0.01, "height": 304.23749999999995, "angle": 0, "strokeCol