 false}, {"id": "greenhouse-00196", "type": "text", "x": 84, "y": 1044, "width": 222.0, "height": 27.0, "angle": 0, "strokeColor": "#287FAF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6076, "version": 1, "versionNonce": 3332, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "← 第 05 关：泵房检修口", "originalText": "← 第 05 关：泵房检修口", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "greenhouse-00197", "type": "rectangle", "x": 1328, "y": 652, "width": 216.0, "height": 32.0, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6107, "version": 1, "versionNonce": 3349, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00198", "type": "text", "x": 1335, "y": 655, "width": 202.0, "height": 27.0, "angle": 0, "strokeColor": "#287FAF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6138, "version": 1, "versionNonce": 3366, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "→ 第 07 关：叶幕走廊", "originalText": "→ 第 07 关：叶幕走廊", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "greenhouse-00199", "type": "rectangle", "x": 1700, "y": 245, "width": 640, "height": 885, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6169, "version": 1, "versionNonce": 3383, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-00200", "type": "text", "x": 1728, "y": 268, "width": 240.0, "height": 40.5, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6200, "version": 1, "versionNonce": 3400, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 30, "fontFamily": 2, "text": "玩家要完成的六步", "originalText": "玩家要完成的六步", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 30}, {"id": "greenhouse-00201", "type": "text", "x": 1730, "y": 330, "width": 242.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6231, "version": 1, "versionNonce": 3417, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "① 先去 B：降下托盘", "originalText": "① 先去 B：降下托盘", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00202", "type": "text", "x": 1730, "y": 372, "width": 291.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6262, "version": 1, "versionNonce": 3434, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "A 保持下层光路。化光到 B，\n将 P 从高位放到低位检修挡。", "originalText": "A 保持下层光路。化光到 B，\n将 P 从高位放到低位检修挡。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00203", "type": "text", "x": 1730, "y": 457, "width": 268.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6293, "version": 1, "versionNonce": 3451, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "② 回程途中：主动脱光", "originalText": "② 回程途中：主动脱光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00204", "type": "text", "x": 1730, "y": 499, "width": 373.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6324, "version": 1, "versionNonce": 3468, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "沿 B → A 回退，在 P 上方按 E。\n恢复实体，短落到托盘，操作低处 K。", "originalText": "沿 B → A 回退，在 P 上方按 E。\n恢复实体，短落到托盘，操作低处 K。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00205", "type": "text", "x": 1730, "y": 584, "width": 294.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6355, "version": 1, "versionNonce": 3485, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "③ 开帘后：重新入光回 B", "originalText": "③ 开帘后：重新入光回 B", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00206", "type": "text", "x": 1730, "y": 626, "width": 337.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6386, "version": 1, "versionNonce": 3502, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "K 将 G 卷起并锁开。沿两级回光阶\n站入原光，三秒化光，返回 B。", "originalText": "K 将 G 卷起并锁开。沿两级回光阶\n站入原光，三秒化光，返回 B。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00207", "type": "text", "x": 1730, "y": 711, "width": 321.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6417, "version": 1, "versionNonce": 3519, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "④ 换用途：升 P，再返回 A", "originalText": "④ 换用途：升 P，再返回 A", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00208", "type": "text", "x": 1730, "y": 753, "width": 352.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6448, "version": 1, "versionNonce": 3536, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "在 B 把 P 升回高位，镜片归位。\n仍沿下层光回 A，再切换上层方向。", "originalText": "在 B 把 P 升回高位，镜片归位。\n仍沿下层光回 A，再切换上层方向。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00209", "type": "text", "x": 1730, "y": 838, "width": 323.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6479, "version": 1, "versionNonce": 3553, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "⑤ 在 C：穿孔校准，接通 D", "originalText": "⑤ 在 C：穿孔校准，接通 D", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00210", "type": "text", "x": 1730, "y": 880, "width": 363.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6510, "version": 1, "versionNonce": 3570, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "恢复实体转 C 镜，让光穿过 F 窄缝。\n高位 P 固定镜承接，折向 D。", "originalText": "恢复实体转 C 镜，让光穿过 F 窄缝。\n高位 P 固定镜承接，折向 D。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00211", "type": "text", "x": 1730, "y": 965, "width": 323.0, "height": 35.1, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6541, "version": 1, "versionNonce": 3587, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 26, "fontFamily": 2, "text": "⑥ 在 D：行路光变为喂养光", "originalText": "⑥ 在 D：行路光变为喂养光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 26}, {"id": "greenhouse-00212", "type": "text", "x": 1730, "y": 1007, "width": 395.0, "height": 59.400000000000006, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6572, "version": 1, "versionNonce": 3604, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "沿 C → P → D 化光抵达，实体调末镜。\n照亮肋侧暗鳞，进入叶幕走廊。", "originalText": "沿 C → P → D 化光抵达，实体调末镜。\n照亮肋侧暗鳞，进入叶幕走廊。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-00213", "type": "rectangle", "x": 60, "y": 1162, "width": 1050, "height": 418, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6603, "version": 1, "versionNonce": 3621, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-0021