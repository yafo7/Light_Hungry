ngle": 0, "strokeColor": "#AD5F50", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 42966, "version": 1, "versionNonce": 23562, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "落空光止于挡片", "originalText": "落空光止于挡片", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "greenhouse-01387", "type": "rectangle", "x": 143, "y": 4702, "width": 488.0, "height": 36.05, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 42997, "version": 1, "versionNonce": 23579, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01388", "type": "text", "x": 150, "y": 4705, "width": 474.0, "height": 31.05, "angle": 0, "strokeColor": "#287FAF", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43028, "version": 1, "versionNonce": 23596, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "C 仍有入射光 → 原路回 A → 改下层 → B 升 P", "originalText": "C 仍有入射光 → 原路回 A → 改下层 → B 升 P", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01389", "type": "text", "x": 88, "y": 4770, "width": 437.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43059, "version": 1, "versionNonce": 23613, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "不重开关卡，也不要求无提示地自杀重置。", "originalText": "不重开关卡，也不要求无提示地自杀重置。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01390", "type": "rectangle", "x": 1190, "y": 4110, "width": 1150, "height": 720, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43090, "version": 1, "versionNonce": 23630, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01391", "type": "text", "x": 1220, "y": 4134, "width": 480.0, "height": 40.5, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43121, "version": 1, "versionNonce": 23647, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 30, "fontFamily": 2, "text": "三组条件同时成立，终点光路才成立", "originalText": "三组条件同时成立，终点光路才成立", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 30}, {"id": "greenhouse-01392", "type": "rectangle", "x": 1222, "y": 4205, "width": 1080, "height": 155, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#F0F3EA", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43152, "version": 1, "versionNonce": 23664, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01393", "type": "text", "x": 1245, "y": 4221, "width": 80.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43183, "version": 1, "versionNonce": 23681, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "进入 C", "originalText": "进入 C", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01394", "type": "text", "x": 1245, "y": 4262, "width": 229.0, "height": 36.45, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43214, "version": 1, "versionNonce": 23698, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "G 打开 + A 选上层", "originalText": "G 打开 + A 选上层", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01395", "type": "text", "x": 1245, "y": 4309, "width": 252.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43245, "version": 1, "versionNonce": 23715, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "K 的锁止动作解决遮光。", "originalText": "K 的锁止动作解决遮光。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01396", "type": "rectangle", "x": 1222, "y": 4390, "width": 1080, "height": 155, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#F0F3EA", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43276, "version": 1, "versionNonce": 23732, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01397", "type": "text", "x": 1245, "y": 4406, "width": 83.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43307, "version": 1, "versionNonce": 23749, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "接通 D", "originalText": "接通 D", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01398", "type": "text", "x": 1245, "y": 4447, "width": 309.0, "height": 36.45, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43338, "version": 1, "versionNonce": 23766, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "P 高位 + C 镜对准 F 窄缝", "originalText": "P 高位 + C 镜对准 F 窄缝", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01399", "type": "text", "x": 1245, "y": 4494, "width": 419.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43369, "version": 1, "versionNonce": 23783, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "同一个 P 不能既留在低位又在高位接光。", "originalText": "同一个 P 不能既留在低位又在高位接光。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01400", "type": "rectangle", "x": 1222, "y": 4575, "width": 1080, "height": 155, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#F0F3EA", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43400, "version": 1, "versionNonce": 23800, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01401", "type": "text", "x": 1245, "y": 4591, "width": 108.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43431, "version": 1, "versionNonce": 23817, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "完成救援", "originalText": "完成救援", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01402", "type": "text", "x": 1245, "y": 4632, "width": 336.0, "height": 36.45, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43462, "version": 1, "versionNonce": 23834, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "实体抵达 D + 末镜对准暗鳞", "originalText": "实体抵达 D + 末镜对准暗鳞", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "greenhouse-01403", "type": "text", "x": 1245, "y": 4679, "width": 483.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43493, "version": 1, "versionNonce": 23851, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "前面的输入光保持，最后一段从照墙改为喂养。", "originalText": "前面的输入光保持，最后一段从照墙改为喂养。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01404", "type": "text", "x": 1222, "y": 4780, "width": 504.0, "height": 32.400000000000006, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43524, "version": 1, "versionNonce": 23868, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 24, "fontFamily": 2, "text": "复杂度来自条件组合与状态切换，不靠倒计时。", "originalText": "复杂度来自条件组合与状态切换，不靠倒计时。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "greenhouse-01405", "type": "rectangle", "x": 60, "y": 4860, "width": 2280, "height": 385, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43555, "version": 1, "versionNonce": 23885, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01406", "type": "text", "x": 90, "y": 4884, "width": 390.0, "height": 40.5, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43586, "version": 1, "versionNonce": 23902, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 30, "fontFamily": 2, "text": "空间与规则必须在灰盒中落实", "originalText": "空间与规则必须在灰盒中落实", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 30}, {"id": "greenhouse-01407", "type": "text", "x": 91, "y": 4940, "width": 813.0, "height": 33.75, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43617, "version": 1, "versionNonce": 23919, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "• P 的落脚区与回光阶分开：下落先到 K，随后走两级短阶重新站进光里。", "originalText": "• P 的落脚区与回光阶分开：下落先到 K，随后走两级短阶重新站进光里。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-01408", "type": "text", "x": 91, "y": 4991, "width": 868.0, "height": 33.75, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43648, "version": 1, "versionNonce": 23936, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "• K 固定在低处；回光阶离 K 超过实体交互范围，不能跳过“降 P”直接操作。", "originalText": "• K 固定在低处；回光阶离 K 超过实体交互范围，不能跳过“降 P”直接操作。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-01409", "type": "text", "x": 91, "y": 5042, "width": 924.0, "height": 33.75, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43679, "version": 1, "versionNonce": 23953, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "• F 是接顶不透光挡板，缝只容光核；既阻止实体横跳，也阻止 C 绕过 P 直接照 D。", "originalText": "• F 是接顶不透光挡板，缝只容光核；既阻止实体横跳，也阻止 C 绕过 P 直接照 D。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-01410", "type": "text", "x": 91, "y": 5093, "width": 940.0, "height": 33.75, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43710, "version": 1, "versionNonce": 23970, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "• P 高位仍能落脚；右挡片同样接顶，只让正确反射光穿孔，不留下可站的挡片顶面。", "originalText": "• P 高位仍能落脚；右挡片同样接顶，只让正确反射光穿孔，不留下可站的挡片顶面。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-01411", "type": "text", "x": 91, "y": 5144, "width": 880.0, "height": 33.75, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43741, "version": 1, "versionNonce": 23987, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 25, "fontFamily": 2, "text": "• 落水回固定岸台，保留 G 与 P 状态；不能把存档落点挂在会被移走的托盘上。", "originalText": "• 落水回固定岸台，保留 G 与 P 状态；不能把存档落点挂在会被移走的托盘上。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 25}, {"id": "greenhouse-01412", "type": "text", "x": 62, "y": 5281, "width": 1089.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43772, "version": 1, "versionNonce": 24004, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "实现边界：当前 E 找地面后直接定位；拟改为检查约 2 个身高内的安全落点与下落净空，再恢复重力短落。", "originalText": "实现边界：当前 E 找地面后直接定位；拟改为检查约 2 个身高内的安全落点与下落净空，再恢复重力短落。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01413", "type": "text", "x": 62, "y": 5326, "width": 1130.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43803, "version": 1, "versionNonce": 24021, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "本次只修改设计与图件。路径依赖已审阅，未宣称完成 Unity 通关测试；具体反射角、跳距、碰撞需实装验证。", "originalText": "本次只修改设计与图件。路径依赖已审阅，未宣称完成 Unity 通关测试；具体反射角、跳距、碰撞需实装验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01414", "type": "text", "x": 62, "y": 5371, "width": 748.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 43834, "version": 1, "versionNonce": 24038, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "空间衔接不变：05 废弃泵房 → 06 温室两座苗床与沟槽 → 07 叶幕走廊。", "originalText": "空间衔接不变：05 废弃泵房 → 06 温室两座苗床与沟槽 → 07 叶幕走廊。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}], "appState": {"viewBackgroundColor": "#F7F5EF", "gridSize": null}, "files": {}}