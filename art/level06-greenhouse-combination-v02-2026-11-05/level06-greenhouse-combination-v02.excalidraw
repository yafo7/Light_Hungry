": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01238", "type": "text", "x": 480, "y": 4010, "width": 182.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38378, "version": 1, "versionNonce": 21046, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "沟壁低位；须站 P", "originalText": "沟壁低位；须站 P", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01239", "type": "text", "x": 880, "y": 4010, "width": 290.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38409, "version": 1, "versionNonce": 21063, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "卷起 G 遮光帘，开放 A → C", "originalText": "卷起 G 遮光帘，开放 A → C", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01240", "type": "text", "x": 1780, "y": 4010, "width": 253.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38440, "version": 1, "versionNonce": 21080, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "棘爪锁开，不随离开复位", "originalText": "棘爪锁开，不随离开复位", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "greenhouse-01241", "type": "rectangle", "x": 60, "y": 4110, "width": 1100, "height": 720, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38471, "version": 1, "versionNonce": 21097, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01242", "type": "text", "x": 88, "y": 4134, "width": 430.0, "height": 40.5, "angle": 0, "strokeColor": "#AD5F50", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38502, "version": 1, "versionNonce": 21114, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false, "fontSize": 30, "fontFamily": 2, "text": "可以试错：G 已开，但 P 忘了升", "originalText": "可以试错：G 已开，但 P 忘了升", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 30}, {"id": "greenhouse-01243", "type": "rectangle", "x": 81.0, "y": 4205.0, "width": 1056.0, "height": 541.2, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 0.66, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 38533, "version": 1, "versionNonce": 21131, "isDeleted": false, "boundElements": null, "updated": 1793836800000, "link": null, "locked": false}, {"id": "greenhouse-01244", "type": "rectangle", "x": 94.2, "y": 4216.88, "width": 1029.6000000000001, "height": 511.5, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#EEF1E9", "fillStyle": "solid", "strokeWidth": 1.32