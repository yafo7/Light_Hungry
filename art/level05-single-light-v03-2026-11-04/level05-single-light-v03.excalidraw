: 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8990, "version": 1, "versionNonce": 4930, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "沿新跳台到 C，转 K2 调 M2。\n从上方观察光斑，接通 D；\n再沿实体跳台返回 A。", "originalText": "沿新跳台到 C，转 K2 调 M2。\n从上方观察光斑，接通 D；\n再沿实体跳台返回 A。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "singlelight-0291", "type": "line", "x": 1700, "y": 790, "width": 410, "height": 0.01, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9021, "version": 1, "versionNonce": 4947, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "points": [[0, 0], [410, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "singlelight-0292", "type": "text", "x": 1700, "y": 809, "width": 190.0, "height": 32.400000000000006, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9052, "version": 1, "versionNonce": 4964, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 24, "fontFamily": 2, "text": "04  沿新路线去 D", "originalText": "04  沿新路线去 D", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "singlelight-0293", "type": "text", "x": 1700, "y": 853, "width": 278.0, "height": 81.0, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9083, "version": 1, "versionNonce": 4981, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "A 充光三秒，再出发。\n沿 M1 → M2 → D 连续反射；\nM2 只是转折点，不在此落脚。", "originalText": "A 充光三秒，再出发。\n沿 M1 → M2 → D 连续反射；\nM2 只是转折点，不在此落脚。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "singlelight-0294", "type": "line", "x": 1700, "y": 948, "width": 410, "height": 0.01, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9114, "version": 1, "versionNonce": 4998, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "points": [[0, 0], [410, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "singlelight-0295", "type": "text", "x": 1700, "y": 967, "width": 260.0, "height": 32.400000000000006, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9145, "version": 1, "versionNonce": 5015, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 24, "fontFamily": 2, "text": "05  把行路光变成喂养光", "originalText": "05  把行路光变成喂养光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "singlelight-0296", "type": "text", "x": 1700, "y": 1011, "width": 282.0, "height": 81.0, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9176, "version": 1, "versionNonce": 5032, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "在 D 恢复实体，转 K3 调 M3。\n同一束光照到侧腹暗鳞。\n根帘舒展后，实体走向温室。", "originalText": "在 D 恢复实体，转 K3 调 M3。\n同一束光照到侧腹暗鳞。\n根帘舒展后，实体走向温室。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "singlelight-0297", "type": "text", "x": 1700, "y": 1155, "width": 315.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9207, "version": 1, "versionNonce": 5049, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "开过的机关保留，旧的光路收回。", "originalText": "开过的机关保留，旧的光路收回。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0298", "type": "rectangle", "x": 60, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9238, "version": 1, "versionNonce": 5066, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0299", "type": "text", "x": 82, "y": 1260, "width": 234.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9269, "version": 1, "versionNonce": 5083, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "M1：决定把光给谁", "originalText": "M1：决定把光给谁", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "singlelight-0300", "type": "text", "x": 82, "y": 1307, "width": 310.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9300, "version": 1, "versionNonce": 5100, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "先照 B，取得跳台；再改照 M2。", "originalText": "先照 B，取得跳台；再改照 M2。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0301", "type": "text", "x": 82, "y": 1345, "width": 336.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9331, "version": 1, "versionNonce": 5117, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "进入下一段，必须放弃上一条光路。", "originalText": "进入下一段，必须放弃上一条光路。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0302", "type": "rectangle", "x": 765, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9362, "version": 1, "versionNonce": 5134, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0303", "type": "text", "x": 787, "y": 1260, "width": 315.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9393, "version": 1, "versionNonce": 5151, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "M2：光到得了，人站不下", "originalText": "M2：光到得了，人站不下", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "singlelight-0304", "type": "text", "x": 787, "y": 1307, "width": 314.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9424, "version": 1, "versionNonce": 5168, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "操纵杆在上方 C；镜面悬在台下。", "originalText": "操纵杆在上方 C；镜面悬在台下。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0305", "type": "text", "x": 787, "y": 1345, "width": 336.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9455, "version": 1, "versionNonce": 5185, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "化光抵达镜面，不等于能操作机关。", "originalText": "化光抵达镜面，不等于能操作机关。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0306", "type": "rectangle", "x": 1470, "y": 1240, "width": 670, "height": 160, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9486, "version": 1, "versionNonce": 5202, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0307", "type": "text", "x": 1492, "y": 1260, "width": 315.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9517, "version": 1, "versionNonce": 5219, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "M3：抵达之后，再次改光", "originalText": "M3：抵达之后，再次改光", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "singlelight-0308", "type": "text", "x": 1492, "y": 1307, "width": 322.0, "height": 28.35, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9548, "version": 1, "versionNonce": 5236, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "来到 D 后，调整同一束光的末段。", "originalText": "来到 D 后，调整同一束光的末段。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0309", "type": "text", "x": 1492, "y": 1345, "width": 336.0, "height": 28.35, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9579, "version": 1, "versionNonce": 5253, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 21, "fontFamily": 2, "text": "喂鳞成功，才从根帘出口进入温室。", "originalText": "喂鳞成功，才从根帘出口进入温室。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 21}, {"id": "singlelight-0310", "type": "text", "x": 62, "y": 1431, "width": 923.0, "height": 31.05, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9610, "version": 1, "versionNonce": 5270, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "全关只有一束有效光，不分裂、不复制；改镜只影响出射段，M0 → A 的入射段始终保留。", "originalText": "全关只有一束有效光，不分裂、不复制；改镜只影响出射段，M0 → A 的入射段始终保留。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "singlelight-0311", "type": "text", "x": 62, "y": 1480, "width": 1043.0, "height": 29.700000000000003, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9641, "version": 1, "versionNonce": 5287, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "站光三秒化光，手动沿光前后移动。机关必须实体操作；A、B、D 首次抵达需化光，C 需走实体检修路线。", "originalText": "站光三秒化光，手动沿光前后移动。机关必须实体操作；A、B、D 首次抵达需化光，C 需走实体检修路线。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "singlelight-0312", "type": "text", "x": 62, "y": 1521, "width": 878.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9672, "version": 1, "versionNonce": 5304, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "v03 设计草图 · 保留微观泵房与透光玻璃 · 未实装；镜架限位、净空、跳距与折射/反射碰撞需灰盒验证。", "originalText": "v03 设计草图 · 保留微观泵房与透光玻璃 · 未实装；镜架限位、净空、跳距与折射/反射碰撞需灰盒验证。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "singlelight-0313", "type": "rectangle", "x": 0, "y": 1660, "width": 2200, "height": 1560, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#F7F5EF", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9703, "version": 1, "versionNonce": 5321, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0314", "type": "text", "x": 60, "y": 1698, "width": 960.0, "height": 56.7, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9734, "version": 1, "versionNonce": 5338, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 42, "fontFamily": 2, "text": "05  同一束光的四种状态｜每格只画当时有效的光路", "originalText": "05  同一束光的四种状态｜每格只画当时有效的光路", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 42}, {"id": "singlelight-0315", "type": "text", "x": 62, "y": 1762, "width": 1143.0, "height": 31.05, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9765, "version": 1, "versionNonce": 5355, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 23, "fontFamily": 2, "text": "同一空间重复四次：金色 = 当前光；灰虚线 = 已熄灭旧路。机关状态可以保留，光本身不能同时留在两条路上。", "originalText": "同一空间重复四次：金色 = 当前光；灰虚线 = 已熄灭旧路。机关状态可以保留，光本身不能同时留在两条路上。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 23}, {"id": "singlelight-0316", "type": "rectangle", "x": 60, "y": 1820, "width": 1010, "height": 640, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#FFFDF8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9796, "version": 1, "versionNonce": 5372, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0317", "type": "text", "x": 80, "y": 1835, "width": 178.0, "height": 36.45, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9827, "version": 1, "versionNonce": 5389, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "①  先照机关舱", "originalText": "①  先照机关舱", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 27}, {"id": "singlelight-0318", "type": "text", "x": 80, "y": 1877, "width": 205.0, "height": 29.700000000000003, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9858, "version": 1, "versionNonce": 5406, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "S → M0 → M1 → B", "originalText": "S → M0 → M1 → B", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}, {"id": "singlelight-0319", "type": "rectangle", "x": 96, "y": 1948, "width": 950, "height": 447, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "#EDF0EB", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9889, "version": 1, "versionNonce": 5423, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0320", "type": "rectangle", "x": 101, "y": 2391, "width": 150, "height": 12, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#DAE2DB", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 9920, "version": 1, "versionNonce": 5440, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false}, {"id": "singlelight-0321", "type": "line", "x": 101, "y": 2391, "width": 150, "height": 12, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "s