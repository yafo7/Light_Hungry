0, "y": 3093, "width": 437.0, "height": 25.650000000000002, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 19809, "version": 1, "versionNonce": 10863, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 2, "text": "光路最后用于喂养，出口根帘舒展；实体进入温室。", "originalText": "光路最后用于喂养，出口根帘舒展；实体进入温室。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 19}, {"id": "singlelight-0640", "type": "text", "x": 62, "y": 3175, "width": 996.0, "height": 29.700000000000003, "angle": 0, "strokeColor": "#263B40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 19840, "version": 1, "versionNonce": 10880, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 2, "text": "关键：必须先回到 A，才把通往 B 的光收走。光态不操作镜子；所有改镜动作都在安全实体平台完成。", "originalText": "关键：必须先回到 A，才把通往 B 的光收走。光态不操作镜子；所有改镜动作都在安全实体平台完成。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 22}], "appState": {"viewBackgroundColor": "#F7F5EF", "gridSize": null}, "files": {}}