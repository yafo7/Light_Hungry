Deleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 20, "fontFamily": 2, "text": "抵达 A，将 M1 对准检修缝。\n化光进 B，展开实体检修跳台；\n再沿同一束光回退到 A。", "originalText": "抵达 A，将 M1 对准检修缝。\n化光进 B，展开实体检修跳台；\n再沿同一束光回退到 A。", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 20}, {"id": "singlelight-0285", "type": "line", "x": 1700, "y": 474, "width": 410, "height": 0.01, "angle": 0, "strokeColor": "#CDD6D1", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8835, "version": 1, "versionNonce": 4845, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "points": [[0, 0], [410, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "singlelight-0286", "type": "text", "x": 1700, "y": 493, "width": 235.0, "height": 32.400000000000006, "angle": 0, "strokeColor": "#478568", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 8866, "version": 1, "versionNonce": 4862, "isDeleted": false, "boundElements": null, "updated": 1793750400000, "link": null, "locked": false, "fontSize": 24, "fontFamily": 2, "text": "02  收回光，改送 M2", "originalText": "02  收回光，改送 M2", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.35, "baseline": 24}, {"id": "singlelight-0287", "type": "text", "x": 1700, "y": 537, "width": 267.0, "height": 81.0, "angle": 0, "strokeColor": "#687A7D", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, 